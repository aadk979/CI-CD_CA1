# Copy to `.env.local` for local development:  cp .env.example .env.local
# Values below match docker-compose.yml (local Postgres + Redis containers).

# PostgreSQL — local Docker container in dev, AWS RDS in production.
# On RDS append `?sslmode=require` (or `verify-full` with the RDS CA bundle).
DATABASE_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public"

# Redis — backs BullMQ queues and the Socket.IO Redis adapter.
REDIS_URL="redis://localhost:6379"

# Port the custom server (Next.js + Socket.IO) listens on.
PORT=3000

# Better Auth — signs session cookies. Any 32+ char random string locally;
# in production generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-dev-only-secret"
# Public URL of the app. https:// makes session cookies Secure (required in production).
BETTER_AUTH_URL="http://localhost:3000"
