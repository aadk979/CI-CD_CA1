// Prisma schema — https://pris.ly/d/prisma-schema
// Connection URL lives in prisma.config.ts (Prisma 7 convention).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Venue {
  id        String    @id @default(cuid())
  name      String
  city      String
  capacity  Int
  events    Event[]
  sections  Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A seating area within a venue (e.g. Floor, Lower Bowl). Seats belong to a section.
model Section {
  id         String      @id @default(cuid())
  venueId    String
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// Short stable code shown on tickets, e.g. "FLR". Unique per venue.
  code       String
  name       String
  sortOrder  Int         @default(0)
  seats      Seat[]
  priceTiers PriceTier[]

  @@unique([venueId, code])
}

/// A physical seat. Per-event availability (holds, sales) is tracked separately.
model Seat {
  id           String            @id @default(cuid())
  sectionId    String
  section      Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Row label: A–Z, then AA, AB, …
  row          String
  /// Seat number within the row, starting at 1 (CHECK constraint in migration).
  number       Int
  reservations SeatReservation[]
  tickets      Ticket[]

  @@unique([sectionId, row, number])
}

/// What a section costs for a specific event. One tier per section per event.
model PriceTier {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Display name, e.g. "Category 1". Several sections may share a name and price.
  name       String
  /// Integer minor units (cents) to avoid floating-point money (CHECK >= 0 in migration).
  priceCents Int
  currency   String  @default("SGD") @db.Char(3)

  @@unique([eventId, sectionId])
  @@index([sectionId])
}

enum EventStatus {
  DRAFT
  ON_SALE
  SOLD_OUT
  CANCELLED
}

model Event {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  description  String?
  startsAt     DateTime
  status       EventStatus       @default(DRAFT)
  /// High-demand on-sale: fans queue in a virtual waiting room and are admitted in
  /// batches before they can pick seats (SCRUM-34/35/36).
  waitingRoom  Boolean           @default(false)
  venueId      String
  venue        Venue             @relation(fields: [venueId], references: [id])
  priceTiers   PriceTier[]
  reservations SeatReservation[]
  orders       Order[]
  tickets      Ticket[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([startsAt])
}

enum ReservationStatus {
  /// Held in a fan's cart until expiresAt, then released.
  HELD
  /// Paid for. Never expires.
  SOLD
}

/// A seat taken for one event, held or sold. The unique (eventId, seatId) index is what
/// makes double booking impossible: a second fan's insert for the same seat fails.
model SeatReservation {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat              @relation(fields: [seatId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReservationStatus @default(HELD)
  /// When a hold lapses. Required while HELD (CHECK in migration), null once SOLD.
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  @@unique([eventId, seatId])
  @@index([userId, eventId])
  @@index([status, expiresAt])
}

enum OrderStatus {
  /// Payment succeeded and the seats were sold to the fan.
  PAID
}

/// A completed purchase: one per checkout, for one event (SCRUM-39).
model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status     OrderStatus @default(PAID)
  /// Sum of the tickets' prices, in cents (CHECK >= 0 in migration).
  totalCents Int
  currency   String      @db.Char(3)
  /// Reference from the (simulated) payment provider, e.g. "pay_…".
  paymentRef String      @unique
  tickets    Ticket[]
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
}

/// One seat bought in an order. Price and tier are copied at purchase time, so a later
/// price change never alters what the fan paid.
model Ticket {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId     String
  seat       Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
  tierName   String
  priceCents Int

  /// A seat can be sold once per event (backs up the SeatReservation guarantee).
  @@unique([eventId, seatId])
  @@index([orderId])
}

// ── Authentication (Better Auth) ────────────────────────────────────────────
// Field names follow Better Auth's core schema; see src/lib/auth.ts.

/// What a signed-in user may do (SCRUM-24). Everyone signs up as a FAN; organisers are
/// granted the role out of band (`npm run organiser:grant`), never through sign-up.
enum UserRole {
  FAN
  ORGANISER
}

model User {
  id            String            @id
  name          String
  /// Stored lower-cased, so uniqueness is effectively case-insensitive.
  email         String            @unique
  emailVerified Boolean           @default(false)
  role          UserRole          @default(FAN)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  reservations  SeatReservation[]
  orders        Order[]
}

/// A login session. Deleting the row (log out) invalidates the cookie immediately.
model Session {
  id        String   @id
  /// Random opaque token; the cookie holds a signed copy of it.
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A way of signing in. For email + password, providerId = "credential" and
/// `password` holds the scrypt hash (never the plain password).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
