# Copy to /opt/ticketing/.env on the Lightsail instance (chmod 600). Never commit real values.

# AWS RDS PostgreSQL endpoint — reachable from Lightsail via VPC peering.
DATABASE_URL="postgresql://ticketing_app:CHANGE_ME@your-db.xxxxxx.ap-southeast-1.rds.amazonaws.com:5432/ticketing?sslmode=require"

# Signs session cookies. Generate a fresh one:  openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME"
# Must be the public https:// URL (session cookies are Secure only over https).
# No domain? Use <static-ip-with-dashes>.sslip.io, e.g. https://13-250-1-2.sslip.io
BETTER_AUTH_URL="https://your-domain.example"

# Host Caddy serves. Use the same host as BETTER_AUTH_URL (e.g. 13-250-1-2.sslip.io) and
# Caddy obtains a Let's Encrypt certificate automatically. ":80" = plain HTTP (logins won't
# stick, because Secure cookies are not sent over http).
SITE_ADDRESS=your-domain.example
