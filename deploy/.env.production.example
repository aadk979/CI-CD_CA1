# Copy to /opt/ticketing/.env on the Lightsail instance (chmod 600). Never commit real values.

# AWS RDS PostgreSQL endpoint — reachable from Lightsail via VPC peering.
DATABASE_URL="postgresql://ticketing_app:CHANGE_ME@your-db.xxxxxx.ap-southeast-1.rds.amazonaws.com:5432/ticketing?sslmode=require"

# Leave as :80 to serve plain HTTP on the static IP, or set a domain for automatic HTTPS.
SITE_ADDRESS=:80
