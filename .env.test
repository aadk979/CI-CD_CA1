# Loaded automatically when NODE_ENV=test (Vitest, Playwright).
# Points at a SEPARATE test database so tests never touch dev or prod data.
# These are throwaway local-container credentials, not secrets.
DATABASE_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing_test?schema=public"
REDIS_URL="redis://localhost:6379/1"
PORT=3100
# Throwaway test-only values (not secrets).
BETTER_AUTH_SECRET="test-only-secret-test-only-secret-test-only"
BETTER_AUTH_URL="http://localhost:3100"
